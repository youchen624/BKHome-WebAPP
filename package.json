{
  "name": "bkhome-webapp",
  "version": "0.1.0",
  "description": "A web APP for multiple functions.",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc --build && npm run build -w apps/web",
    "start": "node apps/api/dist/server.js",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "dev:web": "npm run dev -w apps/web",

    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:push": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs push --config=apps/api/drizzle.config.js",
    "db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate --config=apps/api/drizzle.config.js",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate --config=apps/api/drizzle.config.js",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio --config=apps/api/drizzle.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youchen624/BKHome-WebAPP.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/youchen624/BKHome-WebAPP/issues"
  },
  "homepage": "https://github.com/youchen624/BKHome-WebAPP#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
